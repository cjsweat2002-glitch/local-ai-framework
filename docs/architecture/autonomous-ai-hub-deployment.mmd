flowchart LR
  %% Autonomous AI Hub — recommended full-stack deployment
  U["User Browser\n• Manus OAuth sign-in\n• Branch-scoped chat\n• Live SSE token rendering"]
  G["Custom Domain / HTTPS\nManaged hosting edge"]

  subgraph H["Managed Full-Stack Hosting Environment"]
    direction TB
    UI["React + Vite client\nBlueprint interface"]
    API["Express + tRPC server\nAuth, ownership checks, task router"]
    SSE["Forge SSE endpoint\nToken forwarding + partial-state persistence"]
    SESS["Signed session cookies\nManus OAuth callback"]
    UI --> API
    API --> SSE
    API --> SESS
  end

  subgraph D["Managed Data Layer"]
    DB[("MySQL / TiDB\nusers · conversations · messages · tasks")]
  end

  subgraph P["AI Provider Layer"]
    FORGE["Built-in Forge API\nReal-time streamed completions"]
    MANUS["Manus API v2\nAsync tasks + event polling"]
  end

  subgraph S["Secret & Access Boundary"]
    SECRETS["Hosted environment secrets\nForge key · Manus API credential\nJWT / OAuth configuration"]
  end

  subgraph GH["GitHub Delivery Workflow"]
    REPO["GitHub repository\nSource, tests, workflow files"]
    CI["GitHub Actions (optional)\nLint · type check · Vitest"]
    REPO --> CI
  end

  U -->|HTTPS| G --> UI
  API <-->|persistent history & task state| DB
  SSE -->|Bearer-authenticated streaming| FORGE
  API -->|server-side API calls| MANUS
  SECRETS -. injected only at runtime .-> API
  SECRETS -. injected only at runtime .-> SSE
  REPO -. source export / deployment workflow .-> H

